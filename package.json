{
  "name": "altweb-factory",
  "private": true,
  "version": "2.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/generate-site.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:portfolio": "node tests/portfolio.mjs",
    "test:seo": "node tests/seo.mjs",
    "test": "npm run test:seo && npm run test:browser && npm run test:portfolio"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "esbuild": "0.28.2"
  }
}
